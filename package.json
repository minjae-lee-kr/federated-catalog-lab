{
  "name": "federated-catalog-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A runnable Apollo Federation lab: entity composition, request-scoped batching, partial failure and schema contracts.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "contracts": "node src/check-contracts.ts",
    "impact": "node src/schema-impact-cli.ts",
    "debt": "node src/cancellation-cli.ts",
    "debt:ui": "node src/cancellation-main.ts",
    "demo": "node src/run-scenarios.ts",
    "verify": "pnpm typecheck && pnpm contracts && pnpm test && pnpm build"
  },
  "dependencies": {
    "@apollo/composition": "2.14.4",
    "@apollo/federation-internals": "2.14.4",
    "@apollo/gateway": "2.14.4",
    "@apollo/server": "5.5.1",
    "@apollo/subgraph": "2.14.4",
    "dataloader": "2.2.3",
    "graphql": "16.14.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
