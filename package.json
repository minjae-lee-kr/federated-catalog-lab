{
  "name": "federated-catalog-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cancellation Debt: expose the gap between timed-out callers, concurrency permits and unfinished work over real Apollo Federation HTTP requests.",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "contracts": "node src/check-contracts.ts",
    "impact": "node src/schema-impact-cli.ts",
    "consumer-impact": "node src/consumer-impact-cli.ts",
    "shared-work": "node src/shared-work-cli.ts",
    "batch-failure": "node src/batch-failure-cli.ts",
    "debt": "node src/cancellation-cli.ts",
    "debt:ui": "node src/cancellation-main.ts",
    "debt:export": "node src/cancellation-export-cli.ts",
    "demo": "node src/run-scenarios.ts",
    "verify": "pnpm typecheck && pnpm contracts && pnpm test && pnpm build"
  },
  "dependencies": {
    "@apollo/composition": "2.14.4",
    "@apollo/federation-internals": "2.14.4",
    "@apollo/gateway": "2.14.4",
    "@apollo/server": "5.5.1",
    "@apollo/subgraph": "2.14.4",
    "dataloader": "2.2.3",
    "graphql": "16.14.2"
  },
  "devDependencies": {
    "@graphql-codegen/core": "6.2.2",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@types/node": "24.19.2",
    "graphql-sock": "1.0.1",
    "typescript": "7.0.2"
  }
}
